{
  "name": "boss-ke-game-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 独立游戏官网与本地内容管理后台",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "export": "node --env-file-if-exists=.env scripts/export.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:pages": "node --test --test-timeout=30000 tests/api.test.mjs tests/github.test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  }
}
